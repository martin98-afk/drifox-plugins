{
    "name": "drifox-official",
    "description": "DriFox 官方插件市场 — 托管官方插件与社区贡献插件的统一入口",
    "homepage": "https://github.com/martin98-afk/drifox-plugins",
    "plugins": [
        {
            "name": "example-plugin",
            "description": "DriFox 插件的最小参考实现 — 展示全部 9 类组件（tools/commands/agents/skills/themes/hooks/mcp/lsp/ui）的标准写法。",
            "version": "1.0.0",
            "author": "DriFox Contributors",
            "license": "GPL-3.0-or-later",
            "categories": [
                "theme",
                "mcp",
                "lsp",
                "ui",
                "agent",
                "tool"
            ],
            "source": {
                "type": "git-subdir",
                "url": "https://github.com/martin98-afk/drifox-plugins",
                "path": "plugins/example-plugin",
                "ref": "main"
            },
            "components": {
                "tools": true,
                "commands": true,
                "agents": true,
                "skills": true,
                "themes": true,
                "hooks": true,
                "mcp": true,
                "lsp": true,
                "ui": true
            },
            "keywords": [
                "example",
                "template",
                "development"
            ],
            "drifox": {
                "min_version": "0.5.0"
            },
            "icon": {
                "light": "icon.svg",
                "dark": "icon_dark.svg"
            }
        }
    ]
}
