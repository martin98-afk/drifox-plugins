{
  "description": "kim-service Hook — 提示词自动优化（HookPrompt Python 移植）",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "python",
            "function": ".prompt_optimizer:hook",
            "timeout": 5,
            "enabled": true,
            "id": "kim-service-prompt-optimizer"
          }
        ]
      }
    ]
  }
}
