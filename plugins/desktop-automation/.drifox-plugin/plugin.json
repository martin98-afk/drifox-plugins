{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "desktop-automation",
    "description": "桌面自动化工具（mouse / keyboard / screenshot）—— 通过 pynput + mss 控制桌面，从 DriFox 主程序迁出（工具插件化）",
    "version": "1.0.4",
    "author": {
        "name": "DriFox Contributors"
    },
    "homepage": "https://github.com/martin98-afk/DriFox",
    "license": "MIT",
    "type": "user",
    "keywords": [
        "desktop",
        "automation",
        "screenshot",
        "mouse",
        "keyboard"
    ],
    "components": {
        "tools": true
    },
    "dependencies": {
        "pip": {
            "default": [
                "mss==10.2.0",
                "pynput==1.8.2",
                "six==1.17.0"
            ],
            "darwin": [
                "pyobjc-core==11.1",
                "pyobjc-framework-Quartz==11.1",
                "pyobjc-framework-ApplicationServices==11.1"
            ]
        }
    }
}
