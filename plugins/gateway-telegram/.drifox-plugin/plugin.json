{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "gateway-telegram",
    "display_name": {
        "zh": "Telegram 网关"
    },
    "description": "Telegram 机器人平台适配器（社区插件，万物即插件 Phase E）：私聊/群组/论坛主题/媒体/命令，基于 python-telegram-bot 长轮询。",
    "version": "1.6.0",
    "author": {
        "name": "DriFoxx Team"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins2",
    "license": "MIT",
    "type": "user",
    "components": {
        "gateways": true
    },
    "config_schema": {
        "title": "Telegram 机器人配置",
        "fields": [
            {
                "key": "enabled",
                "label": "启用 Telegram 网关",
                "type": "bool",
                "default": false
            },
            {
                "key": "token",
                "label": "Bot Token",
                "type": "password",
                "default": "",
                "placeholder": "BotFather 获取的 Token"
            },
            {
                "key": "require_mention",
                "label": "群聊 @校验",
                "type": "bool",
                "default": true,
                "description": "群聊中需要 @机器人 才回复"
            },
            {
                "key": "create_bot",
                "label": "创建机器人",
                "type": "link",
                "url": "https://t.me/BotFather",
                "placeholder": "前往 Telegram 找 @BotFather 创建"
            }
        ]
    },
    "dependencies": {
        "pip": {
            "default": [
                "anyio==4.14.2",
                "certifi==2026.7.22",
                "h11==0.16.0",
                "httpcore==1.0.9",
                "httpx==0.28.1",
                "idna==3.19",
                "python-telegram-bot==22.8"
            ]
        }
    },
    "capabilities": [
        "plugin.config.read",
        "plugin.config.write"
    ],
    "min_host_version": "0.7.3"
}
