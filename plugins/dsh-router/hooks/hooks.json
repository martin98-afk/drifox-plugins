{
    "description": "dsh-router Hook — 确定性硬路由：BuildSystemPrompt 注入 persona + UserPromptSubmit 分类引导",
    "hooks": {
        "BuildSystemPrompt": [
            {
                "hooks": [
                    {
                        "type": "python",
                        "function": ".dsh_router_hook:hook_build_system_prompt",
                        "timeout": 5,
                        "enabled": true,
                        "id": "dsh-router-0001-4000-8000-000000000001"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "python",
                        "function": ".dsh_router_hook:hook_user_prompt_submit",
                        "timeout": 5,
                        "enabled": true,
                        "id": "dsh-router-0002-4000-8000-000000000002"
                    }
                ]
            }
        ]
    }
}