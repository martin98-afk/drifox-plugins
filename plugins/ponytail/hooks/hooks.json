{
    "description": "ponytail Hook — 懒人编程模式：UserPromptSubmit 跟踪 /ponytail 模式命令，PreUserMessage 按模式注入规则（DriFox native）",
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "python",
                        "function": ".ponytail_hook:hook_user_prompt_submit",
                        "timeout": 5,
                        "enabled": true,
                        "id": "ponytail_user_prompt_submit",
                        "add_output_to_context": false
                    }
                ]
            }
        ],
        "PreUserMessage": [
            {
                "hooks": [
                    {
                        "type": "python",
                        "function": ".ponytail_hook:hook_pre_user_message",
                        "timeout": 5,
                        "enabled": true,
                        "id": "ponytail_pre_user_message",
                        "add_output_to_context": true,
                        "statusMessage": "Ponytail 模式:"
                    }
                ]
            }
        ]
    }
}