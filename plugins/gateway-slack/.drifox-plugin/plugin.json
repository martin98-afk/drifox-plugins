{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "gateway-slack",
    "description": "Slack 平台适配器（社区插件，万物即插件 Phase E）：使用 Slack Web API 收发消息，支持 Block Kit 格式、长消息分片；基于 slack-sdk。",
    "version": "1.0.0",
    "author": {
        "name": "DriFoxx Team"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins2",
    "license": "MIT",
    "type": "user",
    "components": {
        "gateways": true
    },
    "config_schema": {
        "title": "Slack 机器人配置",
        "fields": [
            {
                "key": "enabled",
                "label": "启用 Slack 网关",
                "type": "bool",
                "default": false
            },
            {
                "key": "bot_token",
                "label": "Bot Token",
                "type": "password",
                "default": "",
                "placeholder": "Slack App Bot Token (xoxb-)"
            },
            {
                "key": "app_token",
                "label": "App Token",
                "type": "password",
                "default": "",
                "placeholder": "Slack App Token (xapp-)"
            },
            {
                "key": "create_bot",
                "label": "创建应用",
                "type": "link",
                "url": "https://api.slack.com/apps",
                "placeholder": "前往 Slack API 创建"
            }
        ]
    }
}
