{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "gateway-feishu",
    "description": "飞书 (Feishu/Lark) WebSocket 模式适配器（社区插件，万物即插件 Phase E）：实时消息收发，基于 lark-oapi SDK。",
    "version": "1.0.0",
    "author": {
        "name": "DriFoxx Team"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins2",
    "license": "MIT",
    "type": "user",
    "components": {
        "gateways": true
    },
    "config_schema": {
        "title": "飞书机器人配置",
        "fields": [
            {
                "key": "enabled",
                "label": "启用飞书网关",
                "type": "bool",
                "default": false
            },
            {
                "key": "app_id",
                "label": "App ID",
                "type": "text",
                "default": "",
                "placeholder": "飞书开放平台 App ID"
            },
            {
                "key": "app_secret",
                "label": "App Secret",
                "type": "password",
                "default": "",
                "placeholder": "飞书开放平台 App Secret"
            }
        ]
    }
}
