{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "gateway-feishu",
    "display_name": {
        "zh": "飞书网关"
    },
    "description": "飞书 (Feishu/Lark) WebSocket 模式适配器（社区插件，万物即插件 Phase E）：实时消息收发，基于 lark-oapi SDK。设置卡支持扫码创建/更新应用并自动申请消息权限（官方设备授权端点）。",
    "version": "1.7.0",
    "author": {
        "name": "DriFoxx Team"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins2",
    "license": "MIT",
    "type": "user",
    "capabilities": [
        "ui.notify"
    ],
    "platforms": [
        "windows",
        "linux",
        "darwin"
    ],
    "dependencies": {
        "pip": {
            "default": [
                "anyio==4.14.2",
                "certifi==2026.7.22",
                "charset-normalizer==3.5.1",
                "h11==0.16.0",
                "httpcore==1.0.9",
                "httpx==0.28.1",
                "idna==3.19",
                "lark-oapi==1.7.3",
                "pycryptodome==3.23.0",
                "requests-toolbelt==1.0.0",
                "requests==2.34.2",
                "urllib3==2.7.0",
                "websockets==15.0.1",
                "segno"
            ]
        }
    },
    "components": {
        "gateways": true,
        "ui": true
    },
    "config_schema": {
        "title": "飞书机器人配置",
        "fields": [
            {
                "key": "enabled",
                "label": "启用飞书网关",
                "type": "bool",
                "default": false
            },
            {
                "key": "app_id",
                "label": "App ID",
                "type": "text",
                "default": "",
                "placeholder": "飞书开放平台 App ID"
            },
            {
                "key": "app_secret",
                "label": "App Secret",
                "type": "password",
                "default": "",
                "placeholder": "飞书开放平台 App Secret"
            },
            {
                "key": "require_mention",
                "label": "群聊 @校验",
                "type": "bool",
                "default": true,
                "description": "群聊中需要 @机器人 才回复（关闭后群里所有消息都会响应）"
            },
            {
                "key": "create_bot",
                "label": "创建应用",
                "type": "link",
                "url": "https://open.feishu.cn/app",
                "placeholder": "前往飞书开放平台创建"
            }
        ]
    }
}
