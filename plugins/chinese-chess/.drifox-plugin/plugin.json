{
  "name": "chinese-chess",
  "description": "中国象棋 — 与大模型对弈的浮动卡片游戏",
  "version": "0.3.0",
  "author": {
    "name": "马丁"
  },
  "license": "GPL-3.0-or-later",
  "type": "user",
  "api_version": 2,
  "min_host_version": "0.6.10",
  "capabilities": [
    "ui.notify",
    "model.config",
    "engine.session"
  ],
  "keywords": [
    "chinese",
    "evolved",
    "xiangqi",
    "象棋"
  ],
  "components": {
    "tools": false,
    "commands": false,
    "agents": false,
    "skills": false,
    "hooks": false,
    "mcp": false,
    "lsp": false,
    "themes": false,
    "ui": true,
    "providers": false,
    "team_templates": false,
    "model_adapters": false,
    "loop_policies": false,
    "storages": false,
    "serializers": false,
    "gateways": false,
    "engines": false
  },
  "config_schema": {
    "title": "中国象棋",
    "fields": [
      {
        "key": "red_control",
        "label": "我方控制方式",
        "type": "select",
        "options": [
          {
            "value": "manual",
            "label": "手动操作"
          },
          {
            "value": "ai",
            "label": "AI 控制"
          }
        ],
        "default": "manual",
        "description": "选择红方（我方）走子是手动点击还是 AI 自动"
      },
      {
        "key": "red_model",
        "label": "我方模型",
        "type": "text",
        "default": "",
        "description": "我方 AI 模型，格式 Provider:Model；留空用主程序当前模型（正常情况用自绘设置卡下拉选择，此字段仅供旧宿主降级手填）"
      },
      {
        "key": "black_model",
        "label": "对方模型",
        "type": "text",
        "default": "",
        "description": "对方 AI 模型，格式 Provider:Model；留空用主程序当前模型（正常情况用自绘设置卡下拉选择，此字段仅供旧宿主降级手填）"
      }
    ]
  }
}
