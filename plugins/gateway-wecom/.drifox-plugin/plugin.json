{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "gateway-wecom",
    "description": "企业微信 (WeCom) AI Bot 适配器（社区插件，万物即插件 Phase E）：通过 WebSocket 长连接与 AI Bot Gateway 通信；不依赖第三方 SDK，复用宿主 aiohttp/httpx。",
    "version": "1.0.0",
    "author": {
        "name": "DriFoxx Team"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins2",
    "license": "MIT",
    "type": "user",
    "components": {
        "gateways": true
    },
    "config_schema": {
        "title": "企业微信机器人配置",
        "fields": [
            {
                "key": "enabled",
                "label": "启用企业微信网关",
                "type": "bool",
                "default": false
            },
            {
                "key": "bot_id",
                "label": "Bot ID",
                "type": "text",
                "default": "",
                "placeholder": "企业微信机器人 BotID"
            },
            {
                "key": "secret",
                "label": "Secret",
                "type": "password",
                "default": "",
                "placeholder": "机器人密钥 Secret"
            },
            {
                "key": "websocket_url",
                "label": "WebSocket",
                "type": "text",
                "default": "wss://openws.work.weixin.qq.com",
                "placeholder": "wss://openws.work.weixin.qq.com"
            },
            {
                "key": "create_bot",
                "label": "创建机器人",
                "type": "link",
                "url": "https://work.weixin.qq.com/",
                "placeholder": "前往企业微信管理后台创建"
            }
        ]
    }
}
