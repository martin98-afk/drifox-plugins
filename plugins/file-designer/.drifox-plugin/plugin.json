{
    "name": "file-designer",
    "display_name": {
        "zh": "多格式文件设计"
    },
    "description": "多格式文件设计模式 — 独立窗口预览 Word/PPT/Excel/CSV/XMind/Mermaid 流程图，页内拾取元素并标注，锚点+文本+截图回填输入框，让模型精确修改。",
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "version": "0.6.0",
    "author": {
        "name": "DriFox Contributors"
    },
    "license": "GPL-3.0-or-later",
    "type": "user",
    "api_version": 2,
    "min_host_version": "0.6.10",
    "capabilities": [
        "input.read",
        "input.write",
        "storage.data_dir"
    ],
    "keywords": [
        "document",
        "docx",
        "powerpoint",
        "pptx",
        "excel",
        "xlsx",
        "csv",
        "xmind",
        "mermaid",
        "preview",
        "pick",
        "word"
    ],
    "dependencies": {
        "pip": {
            "default": [
                "lxml>=3.1.0",
                "openpyxl>=3.1.0",
                "pillow==13.0.0",
                "python-docx>=1.1.0",
                "python-pptx>=1.0.0",
                "typing_extensions==4.16.0",
                "xlsxwriter==3.3.1"
            ]
        }
    },
    "components": {
        "commands": false,
        "ui": true,
        "tools": true
    }
}
