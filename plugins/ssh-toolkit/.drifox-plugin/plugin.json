  "author": "马丁",
  "platforms": ["windows", "linux", "darwin"],
  "dependencies": {
    "pip": {
      "linux": [
        "bcrypt==5.0.0",
        "cffi==2.1.1",
        "cryptography==50.0.0",
        "PyNaCl==1.6.2"
      ],
      "darwin": [
        "bcrypt==5.0.0",
        "cffi==2.1.1",
        "cryptography==50.0.0",
        "PyNaCl==1.6.2"
      ]
    }
  },
  "components": { "tools": true }
