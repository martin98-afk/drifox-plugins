{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "gateway-dingtalk",
    "description": "钉钉 (DingTalk) Stream 模式适配器（社区插件，万物即插件 Phase E）：实时消息收发，支持群/单聊/媒体；基于 dingtalk-stream SDK。",
    "version": "1.0.0",
    "author": {
        "name": "DriFoxx Team"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins2",
    "license": "MIT",
    "type": "user",
    "components": {
        "gateways": true
    },
    "config_schema": {
        "title": "钉钉机器人配置",
        "fields": [
            {
                "key": "enabled",
                "label": "启用钉钉网关",
                "type": "bool",
                "default": false
            },
            {
                "key": "client_id",
                "label": "AppKey",
                "type": "text",
                "default": "",
                "placeholder": "钉钉应用 AppKey"
            },
            {
                "key": "client_secret",
                "label": "AppSecret",
                "type": "password",
                "default": "",
                "placeholder": "钉钉应用 AppSecret"
            },
            {
                "key": "create_bot",
                "label": "创建机器人",
                "type": "link",
                "url": "https://open-dev.dingtalk.com/fe/app",
                "placeholder": "前往钉钉开放平台创建"
            }
        ]
    }
}
