{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "gateway-dingtalk",
    "display_name": {
        "zh": "钉钉网关"
    },
    "description": "钉钉 (DingTalk) Stream 模式适配器（社区插件，万物即插件 Phase E）：实时消息收发，支持群/单聊/媒体；基于 dingtalk-stream SDK。设置卡支持扫码登录（官方设备注册接口，免开放平台配置）。",
    "version": "1.6.0",
    "author": {
        "name": "DriFoxx Team"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins2",
    "license": "MIT",
    "type": "user",
    "api_version": 2,
    "min_host_version": "0.7.2",
    "capabilities": [
        "ui.notify",
        "plugin.config.read",
        "plugin.config.write"
    ],
    "platforms": [
        "windows",
        "linux",
        "darwin"
    ],
    "dependencies": {
        "pip": {
            "default": [
                "aiohappyeyeballs==2.7.1",
                "aiohttp==3.14.3",
                "aiosignal==1.4.0",
                "attrs==26.1.0",
                "certifi==2026.7.22",
                "charset-normalizer==3.5.1",
                "dingtalk-stream==0.24.3",
                "frozenlist==1.8.0",
                "idna==3.19",
                "multidict==6.7.1",
                "propcache==0.5.2",
                "requests==2.34.2",
                "urllib3==2.7.0",
                "websockets==17.0.1",
                "yarl==1.24.5",
                "segno"
            ]
        }
    },
    "components": {
        "gateways": true,
        "ui": true
    },
    "config_schema": {
        "title": "钉钉机器人配置",
        "fields": [
            {
                "key": "enabled",
                "label": "启用钉钉网关",
                "type": "bool",
                "default": false
            },
            {
                "key": "client_id",
                "label": "AppKey",
                "type": "text",
                "default": "",
                "placeholder": "钉钉应用 AppKey"
            },
            {
                "key": "client_secret",
                "label": "AppSecret",
                "type": "password",
                "default": "",
                "placeholder": "钉钉应用 AppSecret"
            },
            {
                "key": "create_bot",
                "label": "创建机器人",
                "type": "link",
                "url": "https://open-dev.dingtalk.com/fe/app",
                "placeholder": "前往钉钉开放平台创建"
            }
        ]
    }
}
